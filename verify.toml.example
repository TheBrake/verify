# Verify — local pre-push secret auditor
# Copy to the repo root as verify.toml (or run: verify init)
# Dotfile form `.verify.toml` is also discovered automatically.

[verify]
# "any" blocks every finding. "high" only blocks critical/high severity.
fail_on = "any"
redact = true
max_file_bytes = 1048576
entropy_enabled = true
entropy_min_length = 24
entropy_threshold = 4.5
block_env_files = true

[paths]
# false (default): append to built-in excludes. true: replace them.
replace_excludes = false
exclude = ["**/tests/fixtures/**", "**/*.md"]

# Custom rules are real regexes, compiled at load time.
# [[rules]]
# id = "prod-postgres"
# description = "No production PostgreSQL connection strings"
# pattern = '(?i)postgres(?:ql)?://[^\s]+:[^\s]+@[^\s]*(?:prod|production)'
# severity = "critical"
# keywords = ["postgres"]

# [[allow]]
# rule = "generic-api-key"
# paths = ["testdata/sample.env"]
# contains = "EXAMPLE_NOT_A_REAL_KEY"
# condition = "and"